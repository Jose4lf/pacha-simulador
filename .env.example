# ============================================================
# PACHA Simulador · Variables de entorno (copia a .env)
# ============================================================
# El proyecto usa PostgreSQL. Elige UNA URL según dónde corras:
#
# ⚠️ IMPORTANTE para Vercel + Neon (evita que la app "se cuelgue"):
#    · Usa SIEMPRE la URL con "-pooler" (PgBouncer, puerto 6543) en Vercel.
#    · Añade ?sslmode=require&connection_limit=5&pool_timeout=10
#    · Neon FREE apaga la BD tras ~5 min sin uso: la primera petición tarda
#      1-2 s en "despertar" (es normal, no es un cuelgue).

# --- Vercel + Neon (RECOMENDADO: URL pooled de neon.tech) ---
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/pacha?sslmode=require&connection_limit=5&pool_timeout=10

# --- Desarrollo local (PostgreSQL embebido, `bun run db`) ---
DATABASE_URL=postgresql://pacha:pacha@localhost:5433/pacha

# --- Railway (plugin PostgreSQL del propio proyecto) ---
# DATABASE_URL=postgresql://usuario:clave@containers-us-west-xxx.railway.app:6543/railway

# --- Render (base de datos gratuita 90 días / paid) ---
# DATABASE_URL=postgresql://usuario:clave@dpg-xxxx.oregon-postgres.render.com/pacha

# --- Supabase (Connection string · Transaction pooler) ---
# DATABASE_URL=postgresql://postgres.xxx:clave@aws-0-region.pooler.supabase.com:6543/postgres

# --- Docker / VPS (PostgreSQL propio) ---
# DATABASE_URL=postgresql://pacha:pacha@localhost:5432/pacha

# --- URL pública del sitio (SEO, opcional) ---
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
