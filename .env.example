# ============================================================
# PACHA Simulador · Variables de entorno (copia a .env)
# ============================================================
# El proyecto usa PostgreSQL. Elige UNA URL según dónde corras:

# --- Desarrollo local (PostgreSQL embebido, `bun run db`) ---
DATABASE_URL=postgresql://pacha:pacha@localhost:5433/pacha

# --- Vercel + Neon (crea la BD gratis en neon.tech) ---
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/pacha?sslmode=require

# --- Railway (plugin PostgreSQL del propio proyecto) ---
# DATABASE_URL=postgresql://usuario:clave@containers-us-west-xxx.railway.app:6543/railway

# --- Render (base de datos gratuita 90 días / paid) ---
# DATABASE_URL=postgresql://usuario:clave@dpg-xxxx.oregon-postgres.render.com/pacha

# --- Supabase (Connection string · Session pooler) ---
# DATABASE_URL=postgresql://postgres.xxx:clave@aws-0-region.pooler.supabase.com:5432/postgres

# --- Docker / VPS (PostgreSQL propio) ---
# DATABASE_URL=postgresql://pacha:pacha@localhost:5432/pacha
